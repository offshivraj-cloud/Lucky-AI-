#!/usr/bin/env python3
"""Generate JARVIS Creator OS PWA icons (pure stdlib, no Pillow needed)."""
import math, os, struct, zlib

OUT = os.path.join(os.path.dirname(__file__), '..', 'public', 'icons')
os.makedirs(OUT, exist_ok=True)

def png_write(path, w, h, pixels):  # pixels: list of rows of (r,g,b,a)
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        c += struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
        return c
    raw = b''.join(b'\x00' + bytes(v for px in row for v in px) for row in pixels)
    data = (b'\x89PNG\r\n\x1a\n'
            + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(raw, 9))
            + chunk(b'IEND', b''))
    with open(path, 'wb') as f:
        f.write(data)

def make(size, path, maskable=False):
    cx = cy = size / 2
    # safe zone for maskable icons
    core_r = size * (0.34 if maskable else 0.30)
    ring1_r = size * (0.42 if maskable else 0.385)
    ring2_r = size * (0.48 if maskable else 0.455)
    bg = (5, 11, 24)

    def px(x, y):
        dx, dy = x - cx, y - cy
        d = math.hypot(dx, dy)
        t = math.atan2(dy, dx)

        # background radial gradient
        tbg = d / (size * 0.72)
        r = bg[0] + 26 * max(0.0, 1 - tbg)
        g = bg[1] + 52 * max(0.0, 1 - tbg)
        b = bg[2] + 90 * max(0.0, 1 - tbg)
        a = 255

        # outer glow behind rings
        glow = max(0.0, 1 - abs(d - ring1_r) / (size * 0.16))
        r += 56 * glow * 0.55; g += 190 * glow * 0.55; b += 245 * glow * 0.55

        # ring 1 (solid bright)
        ring1 = abs(d - ring1_r) < size * 0.014
        if ring1:
            r, g, b = 90, 222, 250
        # ring 1 soft edge
        edge = max(0.0, 1 - abs(d - ring1_r) / (size * 0.012))
        r += 60 * edge * 0.6; g += 220 * edge * 0.6; b += 252 * edge * 0.6

        # ring 2 (fainter, dashed feel via angle)
        ring2 = abs(d - ring2_r) < size * 0.010
        if ring2:
            seg = (t + math.pi) / (math.pi / 8)
            if int(seg) % 3 != 0:
                r, g, b = 129, 140, 248

        # core orb
        cd = d - core_r * 0.55
        core = d < core_r
        if core:
            rr = 44; gg = 196; bb = 245
            # brighter center
            fade = 1 - (d / core_r) * 0.5
            r = rr * fade + 20; g = gg * fade + 8; b = bb * fade + 26
            # subtle white hot spot
            spot = math.exp(-((dx * dx + dy * dy) / (core_r * core_r * 0.28)))
            r += 120 * spot; g += 190 * spot; b += 220 * spot

        # soft alpha fade at extreme edges (round icon)
        fade_out = max(0.0, 1 - max(0.0, d - size * 0.47) / (size * 0.06))
        a = min(255, int(a * fade_out))
        return (min(255, int(r)), min(255, int(g)), min(255, int(b)), a)

    rows = [[px(x, y) for x in range(size)] for y in range(size)]
    png_write(path, size, size, rows)
    print('wrote', path, size, 'px')

if __name__ == '__main__':
    make(512, os.path.join(OUT, 'icon-512.png'))
    make(192, os.path.join(OUT, 'icon-192.png'))
    make(512, os.path.join(OUT, 'icon-maskable-512.png'), maskable=True)
    make(180, os.path.join(OUT, 'apple-touch-icon.png'))
    print('done')

#!/usr/bin/env python3
"""
VideoAnalyzer.py — Multimodal Video & Effect Analyzer (Python edition)
======================================================================
Extracts real frames and audio from a YouTube video with yt-dlp + ffmpeg,
then asks Gemini (vision + audio capable) to break down the visual editing
technique / sound design at a timestamp — with psychology and step-by-step
recreation steps for Premiere Pro / DaVinci Resolve / CapCut.

Requires:  pip install -r requirements.txt   (yt-dlp, google-genai)
Optional:  ffmpeg in PATH (for frame/audio extraction)

Usage:
  export GEMINI_API_KEY=AIza...
  python3 VideoAnalyzer.py "https://www.youtube.com/watch?v=VIDEO_ID" \
      --ts 02:15 \
      --ask "How was this effect made and why was it used?"

  python3 VideoAnalyzer.py URL --ts 00:42 --sound "What is this sound and why does it work?"
"""
import argparse
import base64
import os
import re
import subprocess
import sys
import tempfile


def ts_to_seconds(ts: str) -> float:
    parts = [float(p) for p in str(ts).split(":")]
    if len(parts) == 3:
        return parts[0] * 3600 + parts[1] * 60 + parts[2]
    if len(parts) == 2:
        return parts[0] * 60 + parts[1]
    return parts[0]


def extract_frame(url: str, ts: float, workdir: str) -> str:
    """Download the video (or a snippet) and grab a frame at `ts`."""
    out = os.path.join(workdir, "frame_%03d.jpg")
    # Fast seek: yt-dlp downloads only needed range with --download-sections
    start = max(0, int(ts) - 2)
    dur = 6
    subprocess.run(
        ["yt-dlp", "-f", "bv*[height<=720]+ba/b[height<=720]",
         "--download-sections", f"*{start}-{start + dur}",
         "--force-keyframes-at-cuts", "-o", os.path.join(workdir, "clip.%(ext)s"),
         url], check=True, capture_output=True)
    clip = [f for f in os.listdir(workdir) if f.startswith("clip.")][0]
    subprocess.run(
        ["ffmpeg", "-y", "-ss", str(ts - start), "-i", os.path.join(workdir, clip),
         "-frames:v", "1", "-q:v", "3", out], check=True, capture_output=True)
    return out % 1


def extract_audio(url: str, ts: float, workdir: str) -> str:
    """Grab ~8s of audio around the timestamp."""
    start = max(0, int(ts) - 2)
    out = os.path.join(workdir, "sound.m4a")
    subprocess.run(
        ["yt-dlp", "-f", "ba/b", "--download-sections", f"*{start}-{start + 8}",
         "-o", os.path.join(workdir, "audio.%(ext)s"), url],
        check=True, capture_output=True)
    src = [f for f in os.listdir(workdir) if f.startswith("audio.")][0]
    subprocess.run(["ffmpeg", "-y", "-i", os.path.join(workdir, src), "-c:a", "aac", out],
                   check=True, capture_output=True)
    return out


def b64(path: str, mime: str) -> dict:
    with open(path, "rb") as f:
        return {"inlineData": {"mimeType": mime, "data": base64.b64encode(f.read()).decode()}}


def main():
    ap = argparse.ArgumentParser(description="Gemini multimodal video effect/sound analyzer")
    ap.add_argument("url")
    ap.add_argument("--ts", default="00:00", help="timestamp, e.g. 02:15")
    ap.add_argument("--ask", default="How was this visual effect made and why was it used?",
                    help="the question for Gemini")
    ap.add_argument("--sound", action="store_true", help="analyze the sound at the timestamp instead")
    args = ap.parse_args()

    key = os.environ.get("GEMINI_API_KEY")
    if not key:
        sys.exit("Set GEMINI_API_KEY first, e.g. export GEMINI_API_KEY=AIza...")

    from google import genai
    client = genai.Client(api_key=key)

    ts = ts_to_seconds(args.ts)
    print(f"→ Analyzing {args.url} at {args.ts} ({'SOUND' if args.sound else 'EFFECT'})…")

    with tempfile.TemporaryDirectory() as work:
        parts = []
        if args.sound:
            audio = extract_audio(args.url, ts, work)
            parts.append(b64(audio, "audio/mp4"))
        else:
            frame = extract_frame(args.url, ts, work)
            parts.append(b64(frame, "image/jpeg"))

        prompt = (
            f"You are JARVIS, a video-editing mentor. The user points at {args.ts} of a YouTube video.\n"
            + (f"SOUND question: {args.ask}\nWhat is this sound, why does it work psychologically, "
               "and how to source/recreate it?" if args.sound else
               f"VISUAL question: {args.ask}\nWhat is the editing technique, why was it used (psychology), "
               "and step-by-step recreation in Premiere Pro, DaVinci Resolve and CapCut.")
        )
        parts.append(prompt)

        resp = client.models.generate_content(model="gemini-2.5-flash", contents=parts)
        print("\n" + "═" * 62)
        print(resp.text)
        print("═" * 62)


if __name__ == "__main__":
    main()

