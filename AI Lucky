 * JARVIS CREATOR OS — Server
 * ------------------------------------------------------------------
 * Zero-dependency Node.js server (Node >= 18).
 *  - Serves the PWA (static files from /public)
 *  - Exposes the REST API under /api (search, transcript, analyze, trends...)
 *
 * Run:            node server.js            (or: npm start)
 * With Gemini:    GEMINI_API_KEY=... node server.js
 * Env file:       node --env-file=.env server.js
 */
'use strict';

const http = require('http');
const fs = require('fs');
const path = require('path');
const api = require('./backend/routes/api');

const PORT = process.env.PORT || 3000;
const PUBLIC_DIR = path.join(__dirname, 'public');

const MIME = {
  '.html': 'text/html; charset=utf-8',
  '.js': 'text/javascript; charset=utf-8',
  '.mjs': 'text/javascript; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.gif': 'image/gif',
  '.svg': 'image/svg+xml',
  '.webp': 'image/webp',
  '.ico': 'image/x-icon',
  '.woff2': 'font/woff2',
  '.txt': 'text/plain; charset=utf-8',
  '.mp3': 'audio/mpeg',
  '.wav': 'audio/wav',
  '.webmanifest': 'application/manifest+json'
};

function sendJSON(res, status, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(status, {
    'Content-Type': 'application/json; charset=utf-8',
    'Cache-Control': 'no-store',
    'Access-Control-Allow-Origin': '*'
  });
  res.end(body);
}

function readBody(req) {
  return new Promise((resolve) => {
    let data = '';
    req.on('data', (c) => { data += c; if (data.length > 2e6) req.destroy(); });
    req.on('end', () => { try { resolve(data ? JSON.parse(data) : {}); } catch { resolve({}); } });
    req.on('error', () => resolve({}));
  });
}

function serveStatic(req, res, pathname) {
  // Prevent path traversal
  const safe = pathname.replace(/^\/+/, '');
  let filePath = path.join(PUBLIC_DIR, safe);
  if (!filePath.startsWith(PUBLIC_DIR)) return sendJSON(res, 403, { error: 'Forbidden' });

  fs.stat(filePath, (err, stat) => {
    if (!err && stat.isDirectory()) filePath = path.join(filePath, 'index.html');
    const ext = path.extname(filePath).toLowerCase();
    fs.readFile(filePath, (err2, data) => {
      if (err2) return sendJSON(res, 404, { error: 'Not found' });
      res.writeHead(200, {
        'Content-Type': MIME[ext] || 'application/octet-stream',
        'Cache-Control': ext === '.html' ? 'no-cache' : 'public, max-age=3600'
      });
      res.end(data);
    });
  });
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  const pathname = decodeURIComponent(url.pathname);
  const start = Date.now();

  try {
    if (pathname === '/api/health') {
      return sendJSON(res, 200, { ok: true, service: 'jarvis-creator-os', time: new Date().toISOString() });
    }

    if (pathname.startsWith('/api/')) {
      if (req.method === 'POST' && req.headers['content-type']?.includes('application/json')) {
        req.body = await readBody(req);
      }
      return api.handle(pathname, url, req, res, sendJSON);
    }

    // Service worker must not be cached
    if (pathname === '/sw.js') {
      return serveStatic(req, res, '/sw.js');
    }

    return serveStatic(req, res, pathname === '/' ? '/index.html' : pathname);
  } catch (e) {
    console.error('[server]', e);
    return sendJSON(res, 500, { error: 'Internal error', detail: String(e.message || e) });
  } finally {
    if (pathname.startsWith('/api/')) {
      console.log(`[${req.method}] ${pathname} -> ${res.statusCode || 200} (${Date.now() - start}ms)`);
    }
  }
});

