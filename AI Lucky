/**
 * videoAnalyzer.js
 * ------------------------------------------------------------------
 * Multimodal Video & Effect Analyzer.
 * Analyzes "how was this effect made / why was it used" and
 * "what is this sound / why does it work" for a YouTube video at a
 * given timestamp — using Gemini vision on the video's thumbnail and
 * the transcript chunk around the timestamp.
 *
 * When no Gemini key is configured, the client falls back to the built-in
 * editing-knowledge engine (AssistantBrain.js).
 */
'use strict';

const gemini = require('./geminiService');
const yt = require('./youtubeService');

const SYSTEM = `You are JARVIS, a world-class video editing mentor for content creators. 
You analyze visual editing techniques, sound design and psychology, then explain 
exactly how to recreate them step-by-step in Adobe Premiere Pro, DaVinci Resolve and CapCut.
Keep answers punchy, structured and practical. Use short bullet lines.`;

async function analyzeAtTimestamp(req, { videoId, ts, question }) {
  const details = await yt.videoDetails(videoId);

  // Transcript chunk around the timestamp (for context of what happens on screen)
  let contextText = `Video: "${details.title}" by ${details.channel}.\nDescription: ${(details.description || '').slice(0, 600)}`;
  try {
    const t = await yt.getTranscript(videoId);
    const segs = t.segments;
    const idx = segs.findIndex(s => s.start >= ts - 3);
    const i = Math.max(0, idx < 0 ? segs.length - 1 : idx);
    const chunk = segs.slice(Math.max(0, i - 8), i + 8).map(s => `[${formatTS(s.start)}] ${s.text}`).join('\n');
    contextText += `\n\nWhat is being said around ${formatTS(ts)}:\n${chunk}`;
  } catch { /* transcript optional */ }

  const isSound = /sound|music|audio|sfx|beat|song|noise|effect.*hear|bgm/i.test(question || '');
  const focus = isSound
    ? `The user asks about the SOUND/MUSIC at ${formatTS(ts)}: "${question}". Explain what the sound likely is, why it works psychologically, and how to source/recreate it.`
    : `The user asks about the VISUAL EDITING EFFECT at ${formatTS(ts)}: "${question}". Explain the technique, the psychology behind why it was used, and step-by-step recreation.`;

  const userPrompt = `${contextText}\n\n${focus}\n\nStructure: [What it is] → [Why it works (psychology)] → [How to recreate] with sub-bullets for Premiere Pro, DaVinci Resolve and CapCut.`;

  // Fetch thumbnail bytes → base64 → send as vision input
  let parts = [];
  try {
    const res = await fetch(details.thumb, { headers: { 'User-Agent': 'Mozilla/5.0' } });
    if (res.ok) {
      const buf = Buffer.from(await res.arrayBuffer());
      parts.push({ inlineData: { mimeType: 'image/jpeg', data: buf.toString('base64') } });
    }
  } catch { /* vision is optional */ }
  parts.push({ text: userPrompt });

  const text = await gemini.generate(req, parts, SYSTEM, 1500, 0.6);

  // Try to extract a clean JSON structure from the answer
  return {
    source: 'gemini',
    videoId,
    ts,
    analysis: text,
    markdown: text
  };
}

function formatTS(s) {
  s = Math.max(0, Math.floor(s));
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return h ? `${h}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}` : `${m}:${String(sec).padStart(2, '0')}`;
}

module.exports = { analyzeAtTimestamp, formatTS };
/**
 * api.js — REST router for /api/*
 */
'use strict';

const yt = require('../services/youtubeService');
const gemini = require('../services/geminiService');
const analyzer = require('../services/videoAnalyzer');

function jsonOr(res, sendJSON, fn) {
  return fn().then(
    (data) => sendJSON(res, 200, { ok: true, data }),
    (err) => sendJSON(res, 400, { ok: false, error: err.message || String(err) })
  );
}

async function handle(pathname, url, req, res, sendJSON) {
  const q = url.searchParams;

  switch (pathname) {

    case '/api/search': {
      const query = (q.get('q') || '').trim();
      if (!query) return sendJSON(res, 400, { ok: false, error: 'Missing ?q=' });
      return jsonOr(res, sendJSON, () => yt.searchVideos(query, parseInt(q.get('max') || '10', 10)));
    }

    case '/api/video/latest': {
