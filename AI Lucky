const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36';

const CACHE = new Map();
const cacheGet = (k, ttl) => { const c = CACHE.get(k); if (c && Date.now() - c.t < ttl) return c.v; return null; };
const cacheSet = (k, v) => CACHE.set(k, { v, t: Date.now() });

async function callInnerTube(endpoint, body) {
  const key = endpoint + '::' + JSON.stringify(body).slice(0, 120);
  const hit = cacheGet(key, 1000 * 60 * 10);
  if (hit) return hit;

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 15000);
  let res;
  try {
    res = await fetch(`${BASE}/${endpoint}?key=${INNERTUBE_KEY}`, {
      method: 'POST',
      signal: controller.signal,
      headers: {
        'Content-Type': 'application/json',
        'User-Agent': UA,
        'Origin': 'https://www.youtube.com',
        'Referer': 'https://www.youtube.com/',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ context: { client: CLIENT }, ...body })
    });
  } finally {
    clearTimeout(timer);
  }
  if (!res.ok) throw new Error(`YouTube API error ${res.status}`);
  const json = await res.json();
  cacheSet(key, json);
  return json;
}

