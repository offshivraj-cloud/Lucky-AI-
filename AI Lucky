        if (e.error === 'network') {
          this._listening = false;
          if (this.onError) this.onError({ message: 'Speech service network error — retrying…', code: e.error });
        }
        // other errors → allow the onend auto-restart to recover
      };

      rec.onend = () => {
        const wasListening = this._listening;
        this._rec = null;
        this._clearSilenceCheck();
        if (!wasListening) {
          if (this.onState) this.onState('stopped');
          return;
