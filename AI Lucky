    this.onError = null;    // (err)
    this.callbacksSet = false;
  }

  setLang(lang) { this.lang = lang; if (this._rec) this._rec.lang = lang; }

  start() {
    if (!this.supported) {
      if (this.onState) this.onState('unsupported');
      if (this.onError) this.onError({ message: 'Voice recognition is not supported in this browser. Type your commands instead — everything works the same.' });
      return false;
    }
    if (this._listening) return true;
    this._finalText = '';
    this._startRecognition();
    return true;
  }

  stop() {
    this._listening = false;
    clearTimeout(this._restartTimer);
    this._clearSilenceCheck();
    if (this._rec) {
      try {
        this._rec.onend = null; // prevent auto-restart
        this._rec.abort();
        this._rec.stop();
      } catch { /* noop */ }
      this._rec = null;
    }
    if (this.onState) this.onState('stopped');
  }

  toggle() { return this._listening ? this.stop() : this.start(); }

  _startRecognition() {
    try {
      const rec = new this.SR();
      this._rec = rec;
      rec.lang = this.lang;
      rec.continuous = this.continuous;
      rec.interimResults = this.interimResults;
      rec.maxAlternatives = 1;

      rec.onstart = () => {
        this._listening = true;
        this._lastResultAt = Date.now();
        this._startSilenceCheck();
        if (this.onState) this.onState('listening');
      };

      rec.onresult = (event) => {
        this._lastResultAt = Date.now();
        let interim = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const res = event.results[i];
          const text = res[0]?.transcript || '';
